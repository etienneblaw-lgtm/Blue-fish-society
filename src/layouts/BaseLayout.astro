---
import { ClientRouter } from 'astro:transitions';
// Police servie par le site lui-même (plus d'appel à Google Fonts).
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '@/styles/global.css';
import RadioPlayer from '@/components/RadioPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Sas d'entrée : pas de lecteur visible, pas de raccourcis clavier audio. */
  entry?: boolean;
}

const {
  title = 'Bluefish Society',
  description = 'An archive radio. A gallery of mixes, each one living in its own piece of generative art.',
  entry = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>
  <body data-entry={entry ? '' : undefined}>
    <slot />
    <RadioPlayer />
  </body>
</html>

<style is:global>
  /* Laisse la place au lecteur fixe en bas de page, sans forcer de scroll sur les pages courtes. */
  body:not([data-entry]) main::after {
    content: '';
    display: block;
    height: 3.5rem;
  }

  @media (max-width: 800px) {
    body:not([data-entry]) main::after {
      height: 5.5rem;
    }
  }
</style>
