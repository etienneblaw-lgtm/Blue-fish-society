---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import TrackCard from '@/components/TrackCard.astro';
import { filters, tracks } from '@/data/tracks';
---

<BaseLayout title="Bluefish Society — Track Archive">
  <SiteHeader active="tracks" />
  <main class="archive wano-scroll">
    <section class="controls" aria-label="Filtres de catalogue">
      <div class="search-box">
        <input id="search-input" type="search" placeholder="/ — search title, tag, year…" autocomplete="off" />
      </div>
      <div class="filters" id="filters">
        {filters.map(([value, label]) => <button class:list={[value === 'all' && 'active']} type="button" data-filter={value}>{label}</button>)}
      </div>
    </section>

    <section class="grid" id="track-grid" aria-label="Mixes disponibles">
      {tracks.map((track, index) => <TrackCard track={track} index={index} />)}
    </section>
    <div class="empty" id="empty-state" hidden>[ NO TRACKS FOUND ]</div>
  </main>

  <aside class="global-player" id="global-player" aria-label="Lecteur audio global">
    <div class="gp-info">
      <div class="gp-title" id="gp-title">—</div>
      <div class="gp-meta" id="gp-meta">—</div>
    </div>
    <div class="gp-controls">
      <button id="gp-prev" type="button">◀◀</button>
      <button id="gp-toggle" type="button">▶ PLAY</button>
      <button id="gp-next" type="button">▶▶</button>
    </div>
    <div class="gp-progress-wrap">
      <div class="gp-time" id="gp-time">0:00 / 0:00</div>
      <button class="gp-bar" id="gp-bar" type="button" aria-label="Changer la progression"><span id="gp-fill"></span></button>
    </div>
    <label class="gp-volume">VOL <input id="gp-volume" type="range" min="0" max="1" step="0.01" value="1" /></label>
    <audio id="audio-engine" preload="none"></audio>
  </aside>

  <script>
    const cards = Array.from(document.querySelectorAll('[data-track-card]'));
    const buttons = Array.from(document.querySelectorAll('[data-play-button]'));
    const searchInput = document.getElementById('search-input');
    const filters = document.getElementById('filters');
    const empty = document.getElementById('empty-state');
    const player = document.getElementById('global-player');
    const audio = document.getElementById('audio-engine');
    const gpTitle = document.getElementById('gp-title');
    const gpMeta = document.getElementById('gp-meta');
    const gpToggle = document.getElementById('gp-toggle');
    const gpPrev = document.getElementById('gp-prev');
    const gpNext = document.getElementById('gp-next');
    const gpTime = document.getElementById('gp-time');
    const gpBar = document.getElementById('gp-bar');
    const gpFill = document.getElementById('gp-fill');
    const gpVolume = document.getElementById('gp-volume');
    let currentFilter = 'all';
    let currentIndex = -1;

    const playableCards = cards.filter((card) => card.dataset.trackSrc);

    function formatTime(seconds) {
      if (!seconds || Number.isNaN(seconds)) return '0:00';
      return `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
    }

    function refreshCards() {
      cards.forEach((card, index) => {
        const isPlaying = index === currentIndex && !audio.paused;
        card.classList.toggle('playing', isPlaying);
        const button = card.querySelector('[data-play-button]');
        if (button && card.dataset.trackSrc) button.textContent = isPlaying ? '⏸ PAUSE' : '▶ PLAY';
      });
      gpToggle.textContent = audio.paused ? '▶ PLAY' : '⏸ PAUSE';
    }

    function loadTrack(index) {
      const card = cards[index];
      if (!card || !card.dataset.trackSrc) return;
      currentIndex = index;
      audio.src = card.dataset.trackSrc;
      audio.load();
      audio.play().catch(() => undefined);
      player.classList.add('visible');
      gpTitle.textContent = card.dataset.trackTitle;
      gpMeta.textContent = `${card.dataset.trackArtist} · ${card.dataset.trackMeta}`;
      refreshCards();
    }

    function adjacent(direction) {
      if (currentIndex < 0) return null;
      const currentCard = cards[currentIndex];
      const pos = playableCards.indexOf(currentCard);
      const next = playableCards[pos + direction];
      return next ? cards.indexOf(next) : null;
    }

    function applyFilters() {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;
      cards.forEach((card) => {
        const haystack = `${card.dataset.trackTitle} ${card.dataset.trackArtist} ${card.dataset.trackMeta}`.toLowerCase();
        const type = card.dataset.trackMeta.split(' · ')[1];
        const visible = (currentFilter === 'all' || type === currentFilter) && (!query || haystack.includes(query));
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      empty.hidden = visibleCount !== 0;
    }

    buttons.forEach((button, index) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (currentIndex === index && !audio.paused) audio.pause();
        else if (currentIndex === index) audio.play().catch(() => undefined);
        else loadTrack(index);
      });
    });

    filters.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      currentFilter = target.dataset.filter;
      filters.querySelectorAll('button').forEach((button) => button.classList.toggle('active', button === target));
      applyFilters();
    });

    searchInput.addEventListener('input', applyFilters);
    gpToggle.addEventListener('click', () => currentIndex >= 0 && (audio.paused ? audio.play() : audio.pause()));
    gpPrev.addEventListener('click', () => { const index = adjacent(-1); if (index !== null) loadTrack(index); });
    gpNext.addEventListener('click', () => { const index = adjacent(1); if (index !== null) loadTrack(index); });
    gpVolume.addEventListener('input', () => { audio.volume = Number(gpVolume.value); });
    gpBar.addEventListener('click', (event) => {
      if (!audio.duration) return;
      const rect = gpBar.getBoundingClientRect();
      audio.currentTime = ((event.clientX - rect.left) / rect.width) * audio.duration;
    });

    audio.addEventListener('play', refreshCards);
    audio.addEventListener('pause', refreshCards);
    audio.addEventListener('ended', () => { const index = adjacent(1); if (index !== null) loadTrack(index); });
    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      gpFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
      gpTime.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== searchInput) {
        event.preventDefault();
        searchInput.focus();
      }
      if (event.key === ' ' && document.activeElement !== searchInput && currentIndex >= 0) {
        event.preventDefault();
        audio.paused ? audio.play() : audio.pause();
      }
    });
  </script>
</BaseLayout>

<style>
  .archive { padding-bottom: 6rem; }

  .controls {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--wano-grey-800);
  }

  .search-box { flex: 1; min-width: 220px; }

  .search-box input {
    width: 100%;
    border: 1px solid var(--wano-grey-700);
    border-radius: 0;
    background: var(--wano-black);
    color: var(--wano-white);
    caret-color: var(--wano-green);
    outline: none;
    padding: 0.6rem 1rem;
  }

  .search-box input:focus { border-color: var(--wano-green); }
  .search-box input::placeholder { color: var(--wano-grey-500); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .filters button,
  .gp-controls button {
    border: 1px solid var(--wano-grey-700);
    border-radius: 0;
    background: var(--wano-black);
    color: var(--wano-grey-300);
    cursor: pointer;
    padding: 0.5rem 0.85rem;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    transition: var(--transition-hover);
  }

  .filters button:hover,
  .filters button.active,
  .gp-controls button:hover {
    border-color: var(--wano-green);
    background: var(--wano-green-005);
    color: var(--wano-green);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min), 1fr));
    gap: 1px;
    max-width: var(--container-grid);
    margin: 0 auto;
    padding: 1.5rem 2rem;
    background: var(--wano-grey-850);
  }

  .empty {
    padding: 4rem 2rem;
    text-align: center;
    color: var(--wano-grey-400);
  }

  .global-player {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    display: none;
    align-items: center;
    gap: 1.5rem;
    padding: 0.8rem 2rem;
    border-top: 1px solid var(--wano-green);
    background: var(--wano-black);
  }

  .global-player.visible { display: flex; }
  .gp-info { flex: 0 0 240px; overflow: hidden; }
  .gp-title { color: var(--wano-green); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gp-meta { margin-top: 0.2rem; color: var(--wano-white); font-size: 0.75rem; opacity: 0.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gp-controls { display: flex; gap: 0.8rem; }
  .gp-progress-wrap { display: flex; flex: 1; align-items: center; gap: 0.8rem; }
  .gp-time { flex: 0 0 88px; color: var(--wano-white); font-size: 0.75rem; opacity: 0.6; text-align: right; }

  .gp-bar {
    flex: 1;
    height: 3px;
    border: 0;
    background: var(--wano-grey-700);
    cursor: pointer;
    padding: 0;
    text-align: left;
  }

  .gp-bar span {
    display: block;
    width: 0%;
    height: 100%;
    background: var(--wano-green);
  }

  .gp-volume {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--wano-white);
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .gp-volume input { width: 70px; }

  @media (max-width: 800px) {
    .controls { padding: 1rem; }
    .grid { grid-template-columns: 1fr; padding: 0 0 6rem; }
    .global-player { gap: 0.8rem; padding: 0.7rem 1rem; }
    .gp-info { flex: 0 0 140px; }
    .gp-volume { display: none; }
  }

  @media (max-width: 520px) {
    .gp-info { display: none; }
    .gp-time { display: none; }
  }
</style>
