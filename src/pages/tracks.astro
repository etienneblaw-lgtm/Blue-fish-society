---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import TrackCard from '@/components/TrackCard.astro';
import { filters, tracks } from '@/data/tracks';
---

<BaseLayout title="Bluefish Society — Track Archive">
  <SiteHeader active="tracks" />
  <main class="archive wano-scroll">
    <header class="archive-intro">
      <div class="archive-kicker">BLUEFISH SOCIETY / AUDIO NODE</div>
      <div class="archive-heading">
        <div>
          <h1>TRACK ARCHIVE</h1>
          <p>Public transmissions from the Blue Fish feed.</p>
        </div>
        <div class="archive-count">[{String(tracks.length).padStart(2, '0')} SIGNALS]</div>
      </div>
    </header>

    <section class="controls" aria-label="Filtres de catalogue">
      <div class="search-box">
        <span aria-hidden="true">root@bluefish:archive$</span>
        <input id="search-input" type="search" placeholder="search title, artist, tag..." aria-label="Rechercher une transmission" autocomplete="off" />
      </div>
      <div class="filters" id="filters">
        {filters.map(([value, label]) => <button class:list={[value === 'all' && 'active']} type="button" data-filter={value}>{label}</button>)}
      </div>
    </section>

    <section class="grid" id="track-grid" aria-label="Mixes disponibles">
      {tracks.map((track, index) => <TrackCard track={track} index={index} />)}
    </section>
    <div class="empty" id="empty-state" hidden>[ NO TRACKS FOUND ]</div>
  </main>

  <script>
    import { onPage } from '@/lib/page';

    onPage('#track-grid', (_root, { signal }) => {
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-track-card]'));
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const filters = document.getElementById('filters')!;
      const empty = document.getElementById('empty-state')!;
      // Lu au moment du clic : au chargement direct, le lecteur peut s'initialiser après la page.
      const player = () => (window as any).bfPlayer;
      let currentFilter = 'all';

      // Les boutons lecture pilotent le lecteur unique du site (mode MIX).
      function refreshCards(detail: { slug: string | null; state: string }) {
        cards.forEach((card) => {
          const isPlaying = detail.slug === card.dataset.trackSlug && detail.state === 'playing';
          card.classList.toggle('playing', isPlaying);
          const button = card.querySelector('[data-play-button]');
          if (button && card.dataset.trackSrc) {
            button.textContent = isPlaying ? '⏸' : '▶';
            button.setAttribute('aria-label', isPlaying ? `Mettre ${card.dataset.trackTitle} en pause` : `Lire ${card.dataset.trackTitle}`);
          }
        });
      }

      function applyFilters() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;
        cards.forEach((card) => {
          const haystack = `${card.dataset.trackTitle} ${card.dataset.trackArtist} ${card.dataset.trackMeta}`.toLowerCase();
          const type = card.dataset.trackMeta!.split(' · ')[1];
          const visible = (currentFilter === 'all' || type === currentFilter) && (!query || haystack.includes(query));
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        empty.hidden = visibleCount !== 0;
      }

      cards.forEach((card) => {
        card.querySelector('[data-play-button]')?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          player()?.playMix(card.dataset.trackSlug);
        });
      });

      filters.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLButtonElement)) return;
        currentFilter = target.dataset.filter!;
        filters.querySelectorAll('button').forEach((button) => button.classList.toggle('active', button === target));
        applyFilters();
      });

      searchInput.addEventListener('input', applyFilters);

      document.addEventListener('bf:player-state', (event) => refreshCards((event as CustomEvent).detail), { signal });
      if (player()) {
        const { mode, slug, playing } = player().state();
        refreshCards({ slug: mode === 'mix' ? slug : null, state: playing ? 'playing' : 'paused' });
      }

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === '/' && document.activeElement !== searchInput) {
            event.preventDefault();
            searchInput.focus();
          }
        },
        { signal },
      );
    });
  </script>
</BaseLayout>

<style>
  .archive {
    width: min(100%, 940px);
    min-height: calc(100vh - 73px);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 2.5rem;
  }

  .archive-intro {
    margin-bottom: 1.4rem;
  }

  .archive-kicker {
    margin-bottom: 0.55rem;
    color: var(--bf-turquoise);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
  }

  .archive-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .archive-heading h1 {
    margin: 0;
    color: var(--wano-green);
    font-size: clamp(1.15rem, 2.2vw, 1.65rem);
    line-height: 1;
    letter-spacing: var(--tracking-wide);
  }

  .archive-heading p {
    margin: 0.55rem 0 0;
    color: var(--wano-white);
    font-size: var(--text-sm);
    opacity: 0.56;
  }

  .archive-count {
    color: var(--wano-green-dim);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .controls {
    display: flex;
    justify-content: space-between;
    gap: 0.85rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--wano-grey-800);
    border-bottom: 1px solid var(--wano-grey-800);
  }

  .search-box {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.55rem;
    min-width: 260px;
    color: var(--wano-green-dim);
    font-size: var(--text-xs);
  }

  .search-box input {
    width: 100%;
    min-width: 120px;
    border: 0;
    border-radius: 0;
    background: var(--wano-black);
    color: var(--wano-white);
    caret-color: var(--wano-green);
    outline: none;
    padding: 0.25rem 0;
    font-size: var(--text-xs);
  }

  .search-box input::placeholder { color: var(--wano-grey-500); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.2rem; }

  .filters button {
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--wano-black);
    color: var(--wano-grey-300);
    cursor: pointer;
    padding: 0.28rem 0.45rem;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    transition: var(--transition-hover);
  }

  .filters button:hover,
  .filters button.active {
    border-color: var(--wano-green);
    background: var(--wano-green-005);
    color: var(--wano-green);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.72rem;
  }

  .empty {
    padding: 4rem 2rem;
    text-align: center;
    color: var(--wano-grey-400);
  }

  @media (max-width: 800px) {
    .archive { padding-top: 1.75rem; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .controls { align-items: flex-start; flex-direction: column; }
    .search-box { width: 100%; min-width: 0; }
  }

  @media (max-width: 520px) {
    .archive { padding: 1.4rem 0.8rem 2rem; }
    .archive-heading { align-items: flex-start; flex-direction: column; gap: 0.65rem; }
    .grid { grid-template-columns: 1fr; }
    .filters { width: 100%; }
  }
</style>
