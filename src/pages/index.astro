---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Bluefish Society — Terminal" entry>
  <main class="screen wano-scroll">
    <section id="entry-screen" class="entry-screen" aria-label="Entrée Bluefish Society">
      <div class="entry-terminal" aria-live="polite">
        <div id="terminal-output" class="terminal-output"></div>
        <!-- Le prénom s'affiche dans .name-echo ; le vrai champ, invisible, couvre la ligne
             pour capter le toucher et le clavier. Le curseur reste ainsi centré sous « Name ? ». -->
        <form id="name-prompt" class="name-prompt" hidden novalidate>
          <span id="name-echo" class="name-echo"></span>
          <input
            id="name-input"
            class="name-input"
            type="text"
            maxlength="24"
            autocomplete="given-name"
            autocapitalize="words"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            aria-label="Your name"
          />
        </form>
        <button id="continue-prompt" class="continue-prompt wano-hint" type="button" hidden><span class="hint-desk">PRESS ENTER</span><span class="hint-touch">TAP TO CONTINUE</span></button>
        <span id="entry-cursor" class="inline-cursor wano-cursor" aria-hidden="true" hidden></span>
      </div>
    </section>
    <img id="rabbit-flash" class="rabbit-flash" src="/white-rabbit.webp" alt="" aria-hidden="true" />
  </main>

  <script>
    import { onPage } from '@/lib/page';
    import { navigate } from 'astro:transitions/client';

    onPage('#entry-screen', (_root, { signal, wait }) => {
    const output = document.getElementById('terminal-output');
    const namePrompt = document.getElementById('name-prompt');
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const nameEcho = document.getElementById('name-echo');    const entryCursor = document.getElementById('entry-cursor');
    const continuePrompt = document.getElementById('continue-prompt');
    const entryScreen = document.getElementById('entry-screen');
    const entryTerminal = document.querySelector('.entry-terminal');
    const rabbit = document.getElementById('rabbit-flash') as HTMLImageElement;
    // Décodé à l'avance pour que le flash tienne sur une seule frame.
    rabbit?.decode?.().catch(() => {});
    let canContinue = false;
    let continueAction = 'menu';
    let activeName = 'ANONYME';
    let isCollectingName = false;

    // Source : Second Cerveau/2 - Projets/Blue Fish Society/Textes/Manifesto.md
    // Une chaîne vide = ligne vide entre deux strophes.
    const MANIFESTO = [
      'Getting together is an art form.',
      '',
      'The dance floor is a frame, music is the paint.',
      '',
      'It is the manifestation of our will to share a physical realm and a mental headspace.',
      'It is the ultimate affirmation that we still wish to unite.',
      'Resisting the forces that pull us apart',
      'A bunch of strangers, intertwined, dancing through the same dream',
      'Lost in a moment',
      'For eternity',
      '',
      'Bluefish Society is our digital cove.',
      'Where music has no goals but itself',
      'We cherish it.',
      'And celebrate the memories it helped us create.',
    ];

    function getOnboardedNames() {
      try {
        const stored = localStorage.getItem('bluefish.onboardedNames');
        const names = stored ? JSON.parse(stored) : [];
        return Array.isArray(names) ? names.filter((name) => typeof name === 'string') : [];
      } catch {
        return [];
      }
    }

    function rememberIdentity(name) {
      try {
        localStorage.setItem('bluefish.identity', cleanName(name));
      } catch {
        // The site remains usable when browser storage is unavailable.
      }
    }

    function completeOnboarding(name) {
      const clean = cleanName(name);
      const names = getOnboardedNames();
      if (!names.includes(clean)) names.push(clean);
      try {
        localStorage.setItem('bluefish.onboardedNames', JSON.stringify(names));
        localStorage.setItem('bluefish.identity', clean);
      } catch {
        // The site remains usable when browser storage is unavailable.
      }
    }

    function nameExists(name) {
      const clean = cleanName(name).toLowerCase();
      return getOnboardedNames().some((knownName) => knownName.toLowerCase() === clean);
    }

    function cleanName(value) {
      return (value || 'ANONYME').trim().slice(0, 24) || 'ANONYME';
    }

    function appendLine() {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      output.appendChild(line);
      return line;
    }

    function moveCursorTo(parent) {
      entryCursor.hidden = false;
      parent.appendChild(entryCursor);
    }

    function hideCursor() {
      entryCursor.hidden = true;
      entryCursor.remove();
    }

    // La suite de la phrase, invisible, réserve déjà sa place : la ligne ne glisse pas
    // et aucun mot ne saute à la ligne pendant la frappe.
    function typeLine(text, speed = 28) {
      return new Promise((resolve) => {
        hideCursor();
        const line = appendLine();
        const typed = document.createElement('span');
        const rest = document.createElement('span');
        rest.className = 'terminal-rest';
        rest.setAttribute('aria-hidden', 'true');
        line.append(typed, rest);
        entryCursor.hidden = false;
        line.insertBefore(entryCursor, rest);
        let index = 0;
        const tick = () => {
          typed.textContent = text.slice(0, index);
          rest.textContent = text.slice(index);
          index += 1;
          if (index <= text.length) wait(speed).then(tick);
          else {
            hideCursor();
            rest.remove();
            resolve(line);
          }
        };
        tick();
      });
    }

    function setIdentity(name) {
      activeName = cleanName(name);
    }

    function showContinue(nextAction = 'menu') {
      canContinue = true;
      continueAction = nextAction;
      namePrompt.hidden = true;
      continuePrompt.hidden = false;
      continuePrompt.focus();
    }

    function goToMenu() {
      navigate('/menu');
    }

    async function startManifesto() {
      canContinue = false;
      continuePrompt.hidden = true;
      output.textContent = '';
      entryTerminal.classList.add('is-manifesto');
      // Le lapin flashe au début de la ligne qui passe la moitié du texte.
      const half = MANIFESTO.join('').length / 2;
      let typedChars = 0;
      let rabbitShown = false;
      for (const line of MANIFESTO) {
        if (!rabbitShown && typedChars >= half) {
          await flashRabbit();
          rabbitShown = true;
        }
        if (line) await typeLine(line);
        else {
          appendLine().textContent = ' ';
          await wait(500);
        }
        typedChars += line.length;
      }
      completeOnboarding(activeName);
      showContinue('menu');
      wait(5000).then(startWakeUp);
    }

    async function flashRabbit() {
      rabbit.classList.add('is-visible');
      await wait(90);
      rabbit.classList.remove('is-visible');
    }

    // Façon intro de Matrix : si la personne reste 5 s sur le manifesto.
    async function startWakeUp() {
      continuePrompt.hidden = true;
      entryTerminal.classList.add('is-fading');
      await wait(1200);
      output.textContent = '';
      entryTerminal.classList.remove('is-fading');
      entryScreen.classList.add('is-wakeup');
      const blankLine = appendLine();
      moveCursorTo(blankLine);
      await wait(2000);
      blankLine.remove();
      const wakeLine = await typeLine(`Wake up, ${activeName}...`, 110);
      moveCursorTo(wakeLine);
      await wait(3000);
      continuePrompt.hidden = false;
    }

    function handleContinue() {
      if (!canContinue) return;
      canContinue = false;
      if (continueAction === 'manifesto') startManifesto();
      else goToMenu();
    }

    async function startReturningFlow(name) {
      setIdentity(name);
      await typeLine(`Welcome Back ${activeName}`);
      await typeLine('Good to see you here.');
      showContinue('menu');
    }

    async function startNewFlow() {
      // Sur mobile, le bloc monte dans le haut de l'écran : il reste visible au-dessus du clavier.
      entryScreen.classList.add('is-asking');
      await typeLine('Welcome to the Bluefish Society.');
      await typeLine('Name ?');
      namePrompt.hidden = false;
      moveCursorTo(namePrompt);
      isCollectingName = true;
      // Prénom déjà connu de ce navigateur : il est pré-rempli, Entrée suffit (ou on le corrige).
      let known = '';
      try {
        known = (localStorage.getItem('bluefish.identity') || '').trim().slice(0, 24);
      } catch {
        // Stockage indisponible : champ vide.
      }
      nameInput.value = known;
      nameEcho.textContent = known;
      nameInput.focus();
      nameInput.setSelectionRange(known.length, known.length);
    }

    async function submitName() {
      if (!isCollectingName) return;
      const name = cleanName(nameInput.value);
      if (!nameInput.value.trim()) return;
      const isKnown = nameExists(name);
      isCollectingName = false;
      setIdentity(name);
      rememberIdentity(name);
      hideCursor();
      nameInput.blur();
      namePrompt.hidden = true;
      entryScreen.classList.remove('is-asking');
      output.textContent = '';
      // Geste de l'utilisateur : le navigateur autorise le son, la radio démarre.
      (window as any).bfPlayer?.start();
      if (isKnown) await startReturningFlow(name);
      else {
        await typeLine(`Welcome ${activeName}.`);
        showContinue('manifesto');
      }
    }

    nameInput?.addEventListener('input', () => {
      nameEcho.textContent = nameInput.value;
    });

    nameInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        submitName();
      }
    });

    // Certains claviers mobiles valident sans envoyer la touche Entrée.
    namePrompt?.addEventListener('submit', (event) => {
      event.preventDefault();
      submitName();
    });

    // Un toucher n'importe où : ouvre le clavier pendant la saisie, sinon continue.
    entryScreen?.addEventListener('click', () => {
      if (isCollectingName) nameInput.focus();
      else handleContinue();
    });
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Enter' && canContinue) handleContinue();
      },
      { signal },
    );

    startNewFlow();
    });
  </script>
</BaseLayout>

<style>
  /* svh : la hauteur réellement visible sur mobile, barre d'adresse comprise. */
  .screen {
    min-height: 100svh;
  }

  .entry-screen {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--wano-black);
  }

  .entry-terminal {
    position: relative;
    width: min(100%, 820px);
    min-height: 220px;
    color: var(--wano-green);
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: var(--leading-relaxed);
    text-align: center;
  }

  .terminal-output {
    display: grid;
    gap: 0.2rem;
    transition: opacity 1.2s ease;
  }

  /* Le manifesto entier (15 lignes + PRESS ENTER) doit tenir dans l'écran sans scroll.
     La taille suit la hauteur, et la largeur pour garder la ligne la plus longue (85 car.) sur une ligne. */
  .entry-terminal.is-manifesto {
    width: min(100%, 52em);
    text-align: left;
    font-size: min(1.05rem, calc((100svh - 4rem) / 30), calc((100vw - 4rem) / 52));
    line-height: 1.6;
  }

  .entry-terminal.is-manifesto .terminal-output {
    gap: 0;
  }

  .entry-terminal.is-manifesto .continue-prompt {
    margin-top: 1.5em;
  }

  .entry-terminal.is-fading .terminal-output {
    opacity: 0;
  }

  .entry-screen.is-wakeup {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .rabbit-flash {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(80vw, 80vh);
    height: min(80vw, 80vh);
    object-fit: contain;
    visibility: hidden;
    pointer-events: none;
    z-index: 10;
  }

  .rabbit-flash.is-visible {
    visibility: visible;
  }

  .terminal-line {
    min-height: 1.8em;
    white-space: pre-wrap;
  }

  .name-prompt[hidden],
  .continue-prompt[hidden],
  :global(.inline-cursor[hidden]) {
    display: none !important;
  }

  /* Hors manifesto, une phrase trop longue se coupe en deux lignes équilibrées. */
  .entry-terminal:not(.is-manifesto) .terminal-output :global(.terminal-line) {
    text-wrap: balance;
  }

  .terminal-output :global(.terminal-rest) {
    visibility: hidden;
  }

  .name-prompt {
    position: relative;
    display: block;
    margin: 0.2rem 0 0;
    min-height: 1.8em;
  }

  .name-echo {
    color: var(--wano-white);
    white-space: pre;
  }

  /* Champ invisible posé sur toute la ligne : zone de toucher large, 16px mini contre le zoom iOS. */
  .name-input {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 3rem;
    transform: translateY(-50%);
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: transparent;
    caret-color: transparent;
    font: inherit;
    font-size: max(16px, 1em);
    text-align: center;
    opacity: 0;
  }

  .name-input:focus {
    outline: 0;
  }

  /* Le curseur ne prend aucune largeur : il se pose après le texte sans le décaler. */
  :global(.inline-cursor) {
    position: relative;
  }

  :global(.inline-cursor)::before {
    content: '\2060';
  }

  :global(.inline-cursor)::after {
    content: '';
    position: absolute;
    left: 0.08em;
    bottom: 0.12em;
    width: 0.55em;
    height: 1.1em;
    background: var(--wano-green);
  }

  /* Champ vide : le curseur est pile au centre, sous « Name ? ». */
  .name-echo:empty ~ :global(.inline-cursor)::after {
    left: -0.275em;
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-desk {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  @media (max-width: 700px), (hover: none) and (pointer: coarse) {
    .entry-screen.is-asking {
      align-items: flex-start;
      padding-top: max(1rem, 22svh);
    }
  }

  .continue-prompt {
    margin-top: 2rem;
    border: 0;
    background: transparent;
    color: var(--wano-green);
    cursor: url('/bluefish-cursor.cur'), pointer;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-wider);
  }

  .continue-prompt:hover,
  .continue-prompt:focus-visible {
    background: var(--wano-green);
    color: var(--wano-black);
    outline: none;
  }

  @media (max-width: 700px) {
    .entry-screen {
      padding: 1rem;
    }

    /* Sur mobile les lignes passent à la ligne : environ 21 lignes visibles. */
    .entry-terminal.is-manifesto {
      font-size: min(0.85rem, calc((100svh - 2rem) / 40));
    }
  }
</style>
