---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Bluefish Society — Terminal">
  <main class="screen wano-scroll">
    <section id="entry-screen" class="entry-screen" aria-label="Entrée Bluefish Society">
      <div class="entry-terminal" aria-live="polite">
        <div id="terminal-output" class="terminal-output"></div>
        <div id="name-prompt" class="name-prompt" hidden>
          <input
            id="name-input"
            class="name-input"
            type="text"
            size="1"
            maxlength="24"
            autocomplete="name"
            aria-label="Your name"
          />
        </div>
        <button id="continue-prompt" class="continue-prompt wano-hint" type="button" hidden>PRESS ENTER</button>
        <span id="entry-cursor" class="inline-cursor wano-cursor" aria-hidden="true" hidden></span>
      </div>
    </section>
    <img id="rabbit-flash" class="rabbit-flash" src="/white-rabbit.webp" alt="" aria-hidden="true" />
  </main>

  <script>
    const output = document.getElementById('terminal-output');
    const namePrompt = document.getElementById('name-prompt');
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const entryCursor = document.getElementById('entry-cursor');
    const continuePrompt = document.getElementById('continue-prompt');
    const entryScreen = document.getElementById('entry-screen');
    const entryTerminal = document.querySelector('.entry-terminal');
    const rabbit = document.getElementById('rabbit-flash') as HTMLImageElement;
    // Décodé à l'avance pour que le flash tienne sur une seule frame.
    rabbit?.decode?.().catch(() => {});
    let canContinue = false;
    let continueAction = 'menu';
    let activeName = 'ANONYME';
    let isCollectingName = false;

    // Source : Second Cerveau/2 - Projets/Blue Fish Society/Textes/Manifesto.md
    // Une chaîne vide = ligne vide entre deux strophes.
    const MANIFESTO = [
      'Getting together is an art form.',
      '',
      'The dance floor is a frame, music is the paint.',
      '',
      'It is the manifestation of our will to share a physical realm and a mental headspace.',
      'It is the ultimate affirmation that we still wish to unite.',
      'Resisting the forces that pull us apart',
      'A bunch of strangers, intertwined, dancing through the same dream',
      'Lost in a moment',
      'For eternity',
      '',
      'Bluefish Society is our digital cove.',
      'Where music has no goals but itself',
      'We cherish it.',
      'And celebrate the memories it helped us create.',
    ];

    function wait(ms) {
      return new Promise((resolve) => window.setTimeout(resolve, ms));
    }
    function getOnboardedNames() {
      try {
        const stored = localStorage.getItem('bluefish.onboardedNames');
        const names = stored ? JSON.parse(stored) : [];
        return Array.isArray(names) ? names.filter((name) => typeof name === 'string') : [];
      } catch {
        return [];
      }
    }

    function rememberIdentity(name) {
      try {
        localStorage.setItem('bluefish.identity', cleanName(name));
      } catch {
        // The site remains usable when browser storage is unavailable.
      }
    }

    function completeOnboarding(name) {
      const clean = cleanName(name);
      const names = getOnboardedNames();
      if (!names.includes(clean)) names.push(clean);
      try {
        localStorage.setItem('bluefish.onboardedNames', JSON.stringify(names));
        localStorage.setItem('bluefish.identity', clean);
      } catch {
        // The site remains usable when browser storage is unavailable.
      }
    }

    function nameExists(name) {
      const clean = cleanName(name).toLowerCase();
      return getOnboardedNames().some((knownName) => knownName.toLowerCase() === clean);
    }

    function cleanName(value) {
      return (value || 'ANONYME').trim().slice(0, 24) || 'ANONYME';
    }

    function appendLine() {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      output.appendChild(line);
      return line;
    }

    function moveCursorTo(parent) {
      entryCursor.hidden = false;
      parent.appendChild(entryCursor);
    }

    function hideCursor() {
      entryCursor.hidden = true;
      entryCursor.remove();
    }

    function typeLine(text, speed = 28) {
      return new Promise((resolve) => {
        hideCursor();
        const line = appendLine();
        const textNode = document.createElement('span');
        line.append(textNode);
        moveCursorTo(line);
        let index = 0;
        const tick = () => {
          textNode.textContent = text.slice(0, index);
          index += 1;
          if (index <= text.length) window.setTimeout(tick, speed);
          else {
            hideCursor();
            resolve(line);
          }
        };
        tick();
      });
    }

    function setIdentity(name) {
      activeName = cleanName(name);
    }

    function showContinue(nextAction = 'menu') {
      canContinue = true;
      continueAction = nextAction;
      namePrompt.hidden = true;
      continuePrompt.hidden = false;
      continuePrompt.focus();
    }

    function goToMenu() {
      window.location.href = '/menu';
    }

    async function startManifesto() {
      canContinue = false;
      continuePrompt.hidden = true;
      output.textContent = '';
      entryTerminal.classList.add('is-manifesto');
      // Le lapin flashe au début de la ligne qui passe la moitié du texte.
      const half = MANIFESTO.join('').length / 2;
      let typedChars = 0;
      let rabbitShown = false;
      for (const line of MANIFESTO) {
        if (!rabbitShown && typedChars >= half) {
          await flashRabbit();
          rabbitShown = true;
        }
        if (line) await typeLine(line);
        else {
          appendLine().textContent = ' ';
          await wait(500);
        }
        typedChars += line.length;
      }
      completeOnboarding(activeName);
      showContinue('menu');
      window.setTimeout(startWakeUp, 5000);
    }

    async function flashRabbit() {
      rabbit.classList.add('is-visible');
      await wait(90);
      rabbit.classList.remove('is-visible');
    }

    // Façon intro de Matrix : si la personne reste 5 s sur le manifesto.
    async function startWakeUp() {
      continuePrompt.hidden = true;
      entryTerminal.classList.add('is-fading');
      await wait(1200);
      output.textContent = '';
      entryTerminal.classList.remove('is-fading');
      entryScreen.classList.add('is-wakeup');
      const blankLine = appendLine();
      moveCursorTo(blankLine);
      await wait(2000);
      blankLine.remove();
      const wakeLine = await typeLine(`Wake up, ${activeName}...`, 110);
      moveCursorTo(wakeLine);
      await wait(3000);
      continuePrompt.hidden = false;
    }

    function handleContinue() {
      if (!canContinue) return;
      if (continueAction === 'manifesto') startManifesto();
      else goToMenu();
    }

    async function startReturningFlow(name) {
      setIdentity(name);
      await typeLine(`Welcome Back ${activeName}`);
      await typeLine('Good to see you here.');
      showContinue('menu');
    }

    async function startNewFlow() {
      await typeLine('Welcome to the Blue Fish Society.');
      await typeLine('Name ?');
      namePrompt.hidden = false;
      moveCursorTo(namePrompt);
      isCollectingName = true;
      nameInput.value = '';
      nameInput.size = 1;
      nameInput.focus();
    }

    async function submitName() {
      if (!isCollectingName) return;
      const name = cleanName(nameInput.value);
      if (!nameInput.value.trim()) return;
      const isKnown = nameExists(name);
      isCollectingName = false;
      setIdentity(name);
      rememberIdentity(name);
      hideCursor();
      namePrompt.hidden = true;
      output.textContent = '';
      if (isKnown) await startReturningFlow(name);
      else {
        await typeLine(`Welcome ${activeName}, please press Enter to continue`);
        showContinue('manifesto');
      }
    }

    nameInput?.addEventListener('input', () => {
      nameInput.size = Math.max(1, nameInput.value.length);
    });

    nameInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        submitName();
      }
    });

    continuePrompt?.addEventListener('click', handleContinue);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && canContinue) handleContinue();
    });

    startNewFlow();
  </script>
</BaseLayout>

<style>
  .entry-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--wano-black);
  }

  .entry-terminal {
    position: relative;
    width: min(100%, 820px);
    min-height: 220px;
    color: var(--wano-green);
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: var(--leading-relaxed);
    text-align: center;
  }

  .terminal-output {
    display: grid;
    gap: 0.2rem;
    transition: opacity 1.2s ease;
  }

  /* Le manifesto entier (15 lignes + PRESS ENTER) doit tenir dans l'écran sans scroll.
     La taille suit la hauteur, et la largeur pour garder la ligne la plus longue (85 car.) sur une ligne. */
  .entry-terminal.is-manifesto {
    width: min(100%, 52em);
    text-align: left;
    font-size: min(1.05rem, calc((100svh - 4rem) / 30), calc((100vw - 4rem) / 52));
    line-height: 1.6;
  }

  .entry-terminal.is-manifesto .terminal-output {
    gap: 0;
  }

  .entry-terminal.is-manifesto .continue-prompt {
    margin-top: 1.5em;
  }

  .entry-terminal.is-fading .terminal-output {
    opacity: 0;
  }

  .entry-screen.is-wakeup {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .rabbit-flash {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(80vw, 80vh);
    height: min(80vw, 80vh);
    object-fit: contain;
    visibility: hidden;
    pointer-events: none;
    z-index: 10;
  }

  .rabbit-flash.is-visible {
    visibility: visible;
  }

  .terminal-line {
    min-height: 1.8em;
    white-space: pre-wrap;
  }

  .name-prompt[hidden],
  .continue-prompt[hidden],
  :global(.inline-cursor[hidden]) {
    display: none !important;
  }

  .name-prompt {
    display: block;
    margin-top: 0.2rem;
    min-height: 1.8em;
  }

  .name-input {
    max-width: min(100%, 24ch);
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: var(--wano-white);
    caret-color: transparent;
    font: inherit;
    text-align: center;
  }

  .name-input:focus {
    outline: 0;
  }

  :global(.inline-cursor) {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.08em;
    background: var(--wano-green);
    vertical-align: text-bottom;
  }

  .continue-prompt {
    margin-top: 2rem;
    border: 0;
    background: transparent;
    color: var(--wano-green);
    cursor: pointer;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-wider);
  }

  .continue-prompt:hover,
  .continue-prompt:focus-visible {
    background: var(--wano-green);
    color: var(--wano-black);
    outline: none;
  }

  @media (max-width: 700px) {
    .entry-screen {
      padding: 1rem;
    }

    /* Sur mobile les lignes passent à la ligne : environ 21 lignes visibles. */
    .entry-terminal.is-manifesto {
      font-size: min(0.85rem, calc((100svh - 2rem) / 40));
    }
  }
</style>
