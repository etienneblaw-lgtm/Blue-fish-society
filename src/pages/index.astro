---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Bluefish Society — Terminal">
  <main class="screen wano-scroll">
    <section id="entry-screen" class="entry-screen" aria-label="Entrée Bluefish Society">
      <div class="entry-terminal" aria-live="polite">
        <div id="terminal-output" class="terminal-output"></div>
        <div id="name-prompt" class="name-prompt" hidden>
          <input
            id="name-input"
            class="name-input"
            type="text"
            size="1"
            maxlength="24"
            autocomplete="name"
            aria-label="Your name"
          />
        </div>
        <button id="continue-prompt" class="continue-prompt wano-hint" type="button" hidden>PRESS ENTER</button>
        <span id="entry-cursor" class="inline-cursor wano-cursor" aria-hidden="true" hidden></span>
      </div>
    </section>

  </main>

  <script>
    const output = document.getElementById('terminal-output');
    const namePrompt = document.getElementById('name-prompt');
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const entryCursor = document.getElementById('entry-cursor');
    const continuePrompt = document.getElementById('continue-prompt');
    let canContinue = false;
    let continueAction = 'menu';
    let activeName = 'ANONYME';
    let isCollectingName = false;
    function getOnboardedNames() {
      try {
        const stored = localStorage.getItem('bluefish.onboardedNames');
        const names = stored ? JSON.parse(stored) : [];
        return Array.isArray(names) ? names.filter((name) => typeof name === 'string') : [];
      } catch {
        return [];
      }
    }

    function rememberIdentity(name) {
      try {
        localStorage.setItem('bluefish.identity', cleanName(name));
      } catch {
        // The site remains usable when browser storage is unavailable.
      }
    }

    function completeOnboarding(name) {
      const clean = cleanName(name);
      const names = getOnboardedNames();
      if (!names.includes(clean)) names.push(clean);
      try {
        localStorage.setItem('bluefish.onboardedNames', JSON.stringify(names));
        localStorage.setItem('bluefish.identity', clean);
      } catch {
        // The site remains usable when browser storage is unavailable.
      }
    }

    function nameExists(name) {
      const clean = cleanName(name).toLowerCase();
      return getOnboardedNames().some((knownName) => knownName.toLowerCase() === clean);
    }

    function cleanName(value) {
      return (value || 'ANONYME').trim().slice(0, 24) || 'ANONYME';
    }

    function appendLine() {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      output.appendChild(line);
      return line;
    }

    function moveCursorTo(parent) {
      entryCursor.hidden = false;
      parent.appendChild(entryCursor);
    }

    function hideCursor() {
      entryCursor.hidden = true;
      entryCursor.remove();
    }

    function typeLine(text, speed = 28) {
      return new Promise((resolve) => {
        hideCursor();
        const line = appendLine();
        const textNode = document.createElement('span');
        line.append(textNode);
        moveCursorTo(line);
        let index = 0;
        const tick = () => {
          textNode.textContent = text.slice(0, index);
          index += 1;
          if (index <= text.length) window.setTimeout(tick, speed);
          else {
            hideCursor();
            resolve();
          }
        };
        tick();
      });
    }

    function setIdentity(name) {
      activeName = cleanName(name);
    }

    function showContinue(nextAction = 'menu') {
      canContinue = true;
      continueAction = nextAction;
      namePrompt.hidden = true;
      continuePrompt.hidden = false;
      continuePrompt.focus();
    }

    function goToMenu() {
      window.location.href = '/menu';
    }

    async function startManifesto() {
      canContinue = false;
      continuePrompt.hidden = true;
      output.textContent = '';
      await typeLine("manifesto en cours d'écriture");
      completeOnboarding(activeName);
      showContinue('menu');
    }

    function handleContinue() {
      if (!canContinue) return;
      if (continueAction === 'manifesto') startManifesto();
      else goToMenu();
    }

    async function startReturningFlow(name) {
      setIdentity(name);
      await typeLine(`Welcome Back ${activeName}`);
      await typeLine('Good to see you here.');
      showContinue('menu');
    }

    async function startNewFlow() {
      await typeLine('Welcome to the Blue Fish Society.');
      await typeLine('Name ?');
      namePrompt.hidden = false;
      moveCursorTo(namePrompt);
      isCollectingName = true;
      nameInput.value = '';
      nameInput.size = 1;
      nameInput.focus();
    }

    async function submitName() {
      if (!isCollectingName) return;
      const name = cleanName(nameInput.value);
      if (!nameInput.value.trim()) return;
      const isKnown = nameExists(name);
      isCollectingName = false;
      setIdentity(name);
      rememberIdentity(name);
      hideCursor();
      namePrompt.hidden = true;
      output.textContent = '';
      if (isKnown) await startReturningFlow(name);
      else {
        await typeLine(`Welcome ${activeName}, please press Enter to continue`);
        showContinue('manifesto');
      }
    }

    nameInput?.addEventListener('input', () => {
      nameInput.size = Math.max(1, nameInput.value.length);
    });

    nameInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        submitName();
      }
    });

    continuePrompt?.addEventListener('click', handleContinue);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && canContinue) handleContinue();
    });

    startNewFlow();
  </script>
</BaseLayout>

<style>
  .entry-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--wano-black);
  }

  .entry-terminal {
    position: relative;
    width: min(100%, 820px);
    min-height: 220px;
    color: var(--wano-green);
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: var(--leading-relaxed);
    text-align: center;
  }

  .terminal-output {
    display: grid;
    gap: 0.2rem;
  }

  .terminal-line {
    min-height: 1.8em;
    white-space: pre-wrap;
  }

  .name-prompt[hidden],
  .continue-prompt[hidden],
  :global(.inline-cursor[hidden]) {
    display: none !important;
  }

  .name-prompt {
    display: block;
    margin-top: 0.2rem;
    min-height: 1.8em;
  }

  .name-input {
    max-width: min(100%, 24ch);
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: var(--wano-white);
    caret-color: transparent;
    font: inherit;
    text-align: center;
  }

  .name-input:focus {
    outline: 0;
  }

  :global(.inline-cursor) {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.08em;
    background: var(--wano-green);
    vertical-align: text-bottom;
  }

  .continue-prompt {
    margin-top: 2rem;
    border: 0;
    background: transparent;
    color: var(--wano-green);
    cursor: pointer;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-wider);
  }

  .continue-prompt:hover,
  .continue-prompt:focus-visible {
    background: var(--wano-green);
    color: var(--wano-black);
    outline: none;
  }

  @media (max-width: 700px) {
    .entry-screen {
      padding: 1rem;
    }
  }
</style>
