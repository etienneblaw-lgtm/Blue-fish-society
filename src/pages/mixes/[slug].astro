---
// Page d'un mix. Deux rendus :
// - avec une recette du labo (track.lab) : l'œuvre générative occupe tout l'écran, les infos flottent dessus ;
// - sans recette : l'art ASCII déterministe historique.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BrandFish from '@/components/BrandFish.astro';
import { tracks } from '@/data/tracks';
import { genTrackArt } from '@/lib/ascii';

export function getStaticPaths() {
  return tracks.map((track) => ({ params: { slug: track.slug }, props: { track } }));
}

const { track } = Astro.props;
const hasLab = Boolean(track.lab);
const art = hasLab ? '' : genTrackArt(`${track.id}-${track.asciiSeed}`, track.type, 16, 54);
const paragraphs = track.desc.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const playable = Boolean(track.src && track.durationSec);

// Description sur l'œuvre : une phrase par bloc, lues en colonnes de deux.
// Phrase 1 en haut à gauche, 2 en bas à gauche, 3 en haut à droite, 4 en bas à droite, etc.
// Sur mobile : empilées. Le léger décalage vient du slug : stable d'une visite à l'autre.
const lines = paragraphs.flatMap((p) => p.split(/(?<=[.!?…])\s+(?=\S)/)).map((l) => l.trim()).filter(Boolean);
let seed = [...track.slug].reduce((h, c) => (Math.imul(h, 31) + c.charCodeAt(0)) >>> 0, 7);
const rand = () => {
  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
  return seed / 2 ** 32;
};
const cols = Math.max(1, Math.ceil(lines.length / 2));
const placed = lines.map((text, i) => {
  const col = Math.floor(i / 2);
  const bottom = i % 2 === 1;
  const jx = (rand() - 0.5) * 6;
  const jy = (rand() - 0.5) * 6;
  const dy = (rand() - 0.5) * 2.4; // mobile : petit flottement vertical, en rem
  const xm = 6 + (lines.length > 1 ? i / (lines.length - 1) : 0) * 12 + (rand() - 0.5) * 4;
  // Dernière colonne calée sur le bord droit, les autres réparties depuis la gauche.
  const lastCol = cols > 1 && col === cols - 1;
  const hx = lastCol ? `right:${(7 + jx).toFixed(1)}%` : `left:${(7 + (col / Math.max(1, cols - 1)) * 50 + jx).toFixed(1)}%`;
  const vy = bottom ? `bottom:${(12 + jy).toFixed(1)}%` : `top:${(10 + jy).toFixed(1)}%`;
  return { text, style: `${hx};${vy};--dy:${dy.toFixed(2)}rem;--xm:${xm.toFixed(1)}%` };
});
---

<BaseLayout title={`Bluefish Society — ${track.title}`} description={paragraphs[0] ?? track.title}>
  <SiteHeader active="tracks" />

  {hasLab && (
    <div class="lab-stage" id="lab-stage" data-recipe={JSON.stringify(track.lab)} data-title={track.title} aria-hidden="true">
      <div class="lab-layer"></div>
      <canvas class="lab-canvas"></canvas>
    </div>
  )}

  {hasLab ? (
    <div class="mix-caption" id="mix-caption" data-slug={track.slug}>
      <span class="sr-only">{track.desc}</span>
      {placed.map((line) => (
        <p class="mix-line" style={line.style} data-text={line.text} aria-hidden="true"><span class="mix-line-ghost">{line.text}</span><span class="mix-line-live"><span class="mix-line-typed"></span></span></p>
      ))}
      <span class="mix-caret wano-cursor" aria-hidden="true"></span>
    </div>
    <button class="mix-gate" id="mix-gate" type="button" data-slug={track.slug} hidden aria-label="Lancer le mix">
      <span class="mix-gate-hint wano-hint"><span class="gate-desk">▶ PRESS ENTER TO PLAY</span><span class="gate-touch">▶ TAP TO PLAY</span></span>
    </button>
  ) : (
    <main class="mix-page wano-scroll">
      <section class="mix-shell">
        <div class="mix-meta ui">
          <a href="/tracks">← TRACK ARCHIVE</a>
          <p class="eyebrow">TRANSMISSION {track.id.toUpperCase()}</p>
          <h1>{track.title}</h1>
          <p class="artist">{track.artist} · {track.year} · {track.duration}</p>
          <div class="desc">{paragraphs.map((p) => <p>{p}</p>)}</div>
          {track.manifesto && <p class="manifesto">{track.manifesto}</p>}
          <div class="tags">{track.tags.map((tag) => <span>{tag}</span>)}</div>
          {playable
            ? <button class="mix-play" id="mix-play" type="button" data-slug={track.slug}>▶ PLAY THIS MIX</button>
            : <div class="no-source">⊘ SOURCE AUDIO EN ATTENTE</div>}
        </div>
        <div class="artwork" aria-label="Oeuvre ASCII du mix">
          <pre>{art}</pre>
          <BrandFish class="mix-fish" />
        </div>
      </section>
    </main>
  )}

  <script>
    import { onPage } from '@/lib/page';

    // Bouton lecture : pilote le lecteur unique du site (mode MIX).
    onPage('#mix-play', (button, { signal }) => {
      const slug = button.dataset.slug!;
      // Lu au moment du clic : au chargement direct, le lecteur peut s'initialiser après la page.
      const player = () => (window as any).bfPlayer;

      function refresh(detail: { slug: string | null; state: string }) {
        const isThisMix = detail.slug === slug;
        const isPlaying = isThisMix && detail.state === 'playing';
        button.textContent = isPlaying ? '⏸ PAUSE' : isThisMix ? '▶ RESUME' : '▶ PLAY THIS MIX';
        button.classList.toggle('active', isPlaying);
      }

      button.addEventListener('click', () => player()?.playMix(slug));
      document.addEventListener('bf:player-state', (event) => refresh((event as CustomEvent).detail), { signal });
      if (player()) {
        const { mode, slug: playingSlug, playing } = player().state();
        refresh({ slug: mode === 'mix' ? playingSlug : null, state: playing ? 'playing' : 'paused' });
      }
    });

    // Description : machine à écrire, puis effacement en typewriter inversé.
    onPage('#mix-caption', (caption, { signal }) => {
      // Le player du bas devient celui de ce mix (chargé au début, en pause).
      const slug = caption.dataset.slug!;
      const player = () => (window as any).bfPlayer;
      let readyTimer = 0;
      let tries = 0;
      const prepare = () => {
        const api = player();
        if (api) {
          api.openMix(slug);
          return;
        }
        if (tries < 60) {
          tries += 1;
          readyTimer = window.setTimeout(prepare, 50);
        }
      };
      prepare();

      // Une phrase par bloc, tapées l'une après l'autre, effacées en sens inverse.
      const lines = [...caption.querySelectorAll<HTMLElement>('.mix-line')].map((el) => ({
        typed: el.querySelector<HTMLElement>('.mix-line-typed')!,
        el,
        text: el.dataset.text || '',
      }));
      const caret = caption.querySelector<HTMLElement>('.mix-caret');
      if (!lines.length) {
        caption.hidden = true;
        return;
      }
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        lines.forEach((l) => (l.typed.textContent = l.text));
        caret?.remove();
        return;
      }

      const TYPE = 38;
      const ERASE = 12;
      const GAP = 650; // entre deux phrases
      const HOLD = 8000;
      const PAUSE = 4000;
      let timer = 0;
      let line = 0;
      let index = 0;
      let erasing = false;
      const moveCaret = () => caret && lines[line].typed.parentElement!.appendChild(caret);
      moveCaret();

      const tick = () => {
        if (signal.aborted) return;
        const cur = lines[line];
        if (erasing) {
          index -= 1;
          cur.typed.textContent = cur.text.slice(0, Math.max(0, index));
          if (index > 0) {
            timer = window.setTimeout(tick, ERASE);
            return;
          }
          if (line > 0) {
            line -= 1;
            index = lines[line].text.length;
            moveCaret();
            timer = window.setTimeout(tick, ERASE * 8);
            return;
          }
          erasing = false;
          timer = window.setTimeout(tick, PAUSE);
          return;
        }
        index += 1;
        cur.typed.textContent = cur.text.slice(0, index);
        if (index < cur.text.length) {
          timer = window.setTimeout(tick, TYPE);
          return;
        }
        if (line < lines.length - 1) {
          line += 1;
          index = 0;
          moveCaret();
          timer = window.setTimeout(tick, GAP);
          return;
        }
        erasing = true;
        timer = window.setTimeout(tick, HOLD);
      };

      timer = window.setTimeout(tick, 700);
      signal.addEventListener(
        'abort',
        () => {
          window.clearTimeout(timer);
          window.clearTimeout(readyTimer);
        },
        { once: true },
      );
    });

    // Lancement auto : le mix démarre seul à l'arrivée. Si le navigateur bloque le son
    // (page ouverte directement, sans clic avant), un sas transparent couvre la page :
    // le premier clic, toucher ou Entrée lance le mix et le sas disparaît.
    onPage('#mix-gate', (gate, { signal }) => {
      const slug = gate.dataset.slug!;
      const player = () => (window as any).bfPlayer;
      const setOpen = (open: boolean) => {
        gate.hidden = !open;
      };
      const go = () => {
        player()?.resume();
        setOpen(false);
      };

      document.addEventListener(
        'bf:player-state',
        (event) => {
          const detail = (event as CustomEvent).detail;
          if (detail.slug !== slug) return setOpen(false);
          setOpen(detail.state === 'blocked');
        },
        { signal },
      );
      gate.addEventListener('click', go, { signal });
      document.addEventListener(
        'keydown',
        (event) => {
          if (gate.hidden || event.key !== 'Enter') return;
          event.preventDefault();
          go();
        },
        { signal },
      );
      const s = player()?.state();
      if (s?.blocked && s.slug === slug) setOpen(true);
    });

    // Œuvre du labo : seul l'engine de la recette est chargé.
    onPage('#lab-stage', async (stage, { signal }) => {
      const { mountRecipe } = await import('@/lab/runtime');
      const audio = document.getElementById('bf-audio') as HTMLAudioElement;
      try {
        await mountRecipe(stage, JSON.parse(stage.dataset.recipe!), { audio, title: stage.dataset.title || '', signal });
      } catch (error) {
        console.error('[bluefish lab] œuvre indisponible', error);
        stage.classList.add('is-broken');
      }
    });
  </script>
</BaseLayout>

<style>
  .mix-page {
    min-height: calc(100vh - 73px);
    padding: 2rem;
  }

  .mix-shell {
    display: grid;
    grid-template-columns: minmax(280px, 420px) 1fr;
    gap: 2rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  .mix-meta,
  .artwork {
    border: 1px solid var(--wano-grey-800);
    background: var(--wano-black);
  }

  .mix-meta {
    padding: 1.5rem;
  }

  .eyebrow {
    margin: 2rem 0 0.5rem;
    color: var(--wano-green);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
  }

  h1 {
    margin: 0;
    color: var(--bf-turquoise);
    font-size: clamp(2rem, 7vw, 5rem);
    line-height: 0.95;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .artist {
    color: var(--wano-grey-300);
    font-size: var(--text-sm);
  }

  .desc {
    margin: 1.5rem 0;
    color: var(--wano-white);
    line-height: var(--leading-relaxed);
  }

  .desc p {
    margin: 0 0 0.9rem;
  }

  .manifesto {
    margin: 0 0 1.5rem;
    color: var(--wano-grey-300);
    font-style: italic;
    line-height: var(--leading-relaxed);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .tags span {
    border: 1px solid var(--wano-green-border);
    background: var(--wano-green-005);
    color: var(--wano-green-dim);
    padding: 0.2rem 0.45rem;
    font-size: var(--text-xs);
  }

  .mix-play {
    width: 100%;
    padding: 0.85rem;
    border: 1px solid var(--wano-green);
    background: transparent;
    color: var(--wano-green);
    font: inherit;
    letter-spacing: var(--tracking-wider);
    cursor: url('/bluefish-cursor.cur'), pointer;
  }

  .mix-play:hover,
  .mix-play:focus-visible,
  .mix-play.active {
    background: var(--wano-green);
    color: var(--wano-black);
    outline: none;
  }

  .no-source {
    border: 1px solid var(--wano-grey-800);
    color: var(--wano-grey-400);
    padding: 0.85rem;
    font-size: var(--text-sm);
  }

  .artwork {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    padding: 2rem;
    background:
      linear-gradient(90deg, rgba(31, 243, 224, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(31, 243, 224, 0.04) 1px, transparent 1px),
      var(--wano-black);
    background-size: 24px 24px;
  }

  .artwork pre {
    color: var(--wano-green);
    font-size: clamp(0.52rem, 1vw, 0.9rem);
    line-height: 1.12;
    opacity: 0.72;
    white-space: pre;
  }

  :global(.mix-fish) {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    font-size: 9px;
    opacity: 0.24;
  }

  /* ── Description éclatée sur l'œuvre ──────────────────────────────────── */
  .mix-caption {
    position: fixed;
    inset: 73px 0 52px;
    z-index: 3;
    pointer-events: none;
  }

  .mix-line {
    position: absolute;
    max-width: min(34ch, 40vw);
    margin: 0;
    color: var(--bf-turquoise);
    font-size: clamp(0.76rem, 1.05vw, 0.9rem);
    line-height: 1.7;
    text-align: left;
    text-shadow: 0 0 14px rgba(0, 0, 0, 0.95), 0 0 6px rgba(0, 0, 0, 0.95), 0 0 2px rgba(0, 0, 0, 1);
  }

  .mix-gate {
    position: fixed;
    inset: 73px 0 52px;
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 2.2rem;
    border: 0;
    background: transparent;
    color: var(--bf-turquoise);
    font: inherit;
    letter-spacing: var(--tracking-wider);
    cursor: url('/bluefish-cursor.cur'), pointer;
  }

  .mix-gate[hidden] { display: none; }

  .mix-gate-hint {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--bf-turquoise);
    background: rgba(0, 0, 0, 0.7);
    font-size: var(--text-sm);
  }

  .gate-touch { display: none; }

  @media (hover: none) {
    .gate-desk { display: none; }
    .gate-touch { display: inline; }
  }

  /* La phrase complète, invisible, réserve sa place : rien ne bouge pendant la frappe. */
  .mix-line-ghost { visibility: hidden; }
  .mix-line-live { position: absolute; inset: 0; }

  .mix-caret {
    margin-left: 1px;
    color: var(--bf-turquoise);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .mix-caption { inset: 65px 0 96px; }
    .mix-caption {
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      padding: 1.5rem 0;
    }
    .mix-line {
      position: relative;
      inset: auto !important;
      max-width: 78vw;
      margin-left: var(--xm);
      transform: translateY(var(--dy));
    }
  }

  /* ── Œuvre du labo en plein écran ─────────────────────────────────────── */
  .lab-stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--wano-black);
  }

  .lab-stage .lab-canvas {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .lab-stage .lab-layer {
    position: fixed;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .lab-stage .lab-layer:has(*) {
    pointer-events: auto;
  }

  .lab-stage:global(.is-broken) { display: none; }

  /* Le contenu laisse passer la souris vers l'œuvre, sauf la fiche du mix. */
  .mix-page.has-lab {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  .mix-shell.is-floating {
    display: block;
    max-width: none;
  }

  .is-floating .mix-meta {
    width: min(100%, 420px);
    max-height: calc(100vh - 73px - 7rem);
    overflow-y: auto;
    border-color: var(--wano-green-border);
    background: rgba(0, 0, 0, 0.82);
    pointer-events: auto;
    backdrop-filter: blur(2px);
    scrollbar-width: thin;
    scrollbar-color: var(--wano-green-border) transparent;
  }

  .is-floating h1 {
    font-size: clamp(2rem, 5vw, 3.6rem);
  }

  @media (max-width: 900px) {
    .mix-page { padding: 1rem; }
    .mix-shell { grid-template-columns: 1fr; }
    .artwork { min-height: auto; overflow-x: auto; }
    .is-floating .mix-meta { max-height: none; }
  }
</style>
