---
interface Props {
  active?: 'terminal' | 'tracks' | 'about';
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="site-brand">BLUEFISH SOCIETY</div>
  <nav class="site-nav" aria-label="Navigation principale">
    <a href="/menu" class:list={[active === 'terminal' && 'active']}>← MENU</a>
    <a href="/tracks" class:list={[active === 'tracks' && 'active']}>TRACK ARCHIVE</a>
    <a href="/#manifesto-anchor" class:list={[active === 'about' && 'active']}>MANIFESTO</a>
  </nav>
</header>
